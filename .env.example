# Load with:  set -a; source .env; set +a
# template (default, no LLM) | anthropic
LLM_PROVIDER=template
# Required when LLM_PROVIDER=anthropic, e.g. claude-haiku-4-5
LLM_MODEL=
ANTHROPIC_API_KEY=
# Default 2, hard cap 4
MAX_HOPS=2
# off | record | replay  (defaults to record when LLM_PROVIDER=anthropic)
REPLAY_MODE=
